POLYMARKET_PRIVATE_KEY=your_private_key_here
CAPITAL_USD=50
DRY_RUN=true # true for testing, false for real trading

# STRATEGIES CONFIG false as defualt
ARBITRAGE_ENABLED=false
DIPARB_ENABLED=false
SMARTMONEY_ENABLED=false
TREND_ANALYSIS_ENABLED=false

# ==============================================
# 🆕 2026 CLOB V2 / pUSD COMPATIBILITY (all optional)
# ==============================================
# Everything below is OPTIONAL and purely additive. If you leave these blank,
# the bot behaves exactly like before: your private key trades directly as an
# EOA (signatureType 0) with no funder wallet, and API credentials are
# derived automatically on every start.

# Only set FUNDER_ADDRESS if your Polymarket account wallet is different from
# the signer above - e.g. you log in to polymarket.com via email/Magic Link,
# or your account uses a Deposit Wallet (accounts created after May 4, 2026).
# Find this address in your Polymarket profile / account settings.
FUNDER_ADDRESS=

# Signature type matching FUNDER_ADDRESS's wallet type. Only used if
# FUNDER_ADDRESS is set. 0=EOA (default), 1=Proxy (Magic Link/email),
# 2=Gnosis Safe, 3=Deposit Wallet (current default for new accounts).
SIGNATURE_TYPE=0

# Polygon chain ID. Defaults to 137 (mainnet) if left blank.
CHAIN_ID=137

# Pre-generated CLOB API credentials. Optional - if blank, the bot derives or
# creates these automatically on startup (same as previous versions).
API_KEY=
API_SECRET=
API_PASSPHRASE=

# Optional Polymarket Builder Program attribution code (V2). Leave blank
# unless you have a builder profile at https://polymarket.com/settings?tab=builder
POLY_BUILDER_CODE=
